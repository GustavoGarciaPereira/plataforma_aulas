# Copie para .env e ajuste os valores (o .env NÃO deve ser versionado).
# Produção / Postgres local:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/plataforma_aulas
# Dev sem Postgres (SQLite — arquivo dev.db na raiz, ignorado pelo git):
# DATABASE_URL=sqlite:///./dev.db
# Gere uma chave real com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-troque-no-env
